{
  "name": "merke-und-male",
  "version": "1.9.1",
  "main": "expo-router/entry",
  "homepage": "https://s540d.github.io/DrawFromMemory/",
  "repository": {
    "type": "git",
    "url": "https://github.com/S540d/DrawFromMemory.git"
  },
  "bugs": {
    "url": "https://github.com/S540d/DrawFromMemory/issues"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:doctor": "bash scripts/build-doctor.sh",
    "build:android:local": "bash scripts/build-local.sh preview",
    "build:android:local:preview": "bash scripts/build-local.sh preview",
    "build:android:local:production": "bash scripts/build-local.sh production",
    "build:ios": "eas build --platform ios --profile production",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "validate:svg-counts": "node scripts/validate-svg-counts.js",
    "validate": "./scripts/validate-release.sh",
    "deploy:ghpages": "./scripts/deploy-ghpages.sh",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~58.0.16",
    "@lottiefiles/dotlottie-react": "^0.21.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@sentry/react-native": "~8.33.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "~30.5.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~58.0.23",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-linking": "~58.0.15",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react-test-renderer": "19.2.0",
    "ws": "^8.21.0",
    "metro": "0.83.8",
    "metro-config": "0.83.8",
    "metro-transform-worker": "0.83.8"
  },
  "private": true
}
